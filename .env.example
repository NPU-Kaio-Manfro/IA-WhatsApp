# SMTP (envio do relatório por e-mail)
# Exemplo com Resend (https://resend.com) — SMTP_USER é sempre a palavra "resend",
# SMTP_PASS é a API key gerada no painel. Para usar Gmail em vez disso, veja o
# README (precisa de "senha de app", não a senha normal da conta).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_sua_api_key_aqui

# Remetente do e-mail (precisa ser um e-mail válido — com Resend, use
# onboarding@resend.dev para testes, ou um e-mail do seu domínio verificado)
EMAIL_FROM=onboarding@resend.dev

# Destinatário do relatório
EMAIL_TO=desenvolvimento@hinc.com.br

# Agendamento do cron (formato node-cron; padrão: todo dia às 09:00)
CRON_SCHEDULE=0 9 * * *

# Faixas de dias sem resposta que disparam alerta (dias em que cada faixa começa)
SLA_THRESHOLDS=3,5,15

# Caminho do banco SQLite
DB_PATH=./data/contacts.db

# Caminho do arquivo de log de erros
ERROR_LOG_PATH=./logs/errors.log
